# ─────────────────────────────────────────────────────────────
#  FoodRush — Environment Configuration
#  Copy this to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# Project
PROJECT_NAME=FoodRush API
VERSION=1.0.0
ENVIRONMENT=development          # development | staging | production

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/foodrush

# JWT — generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_USE_OPENSSL_RAND_HEX_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440   # 24 h
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — comma-separated origins
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
ALLOWED_HOSTS=["*"]

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
